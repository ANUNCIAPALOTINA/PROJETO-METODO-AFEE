# Modelo das variáveis de ambiente. Copie para .env.local e preencha.
# NUNCA coloque valores reais neste arquivo nem commite o .env.local.
# Na Netlify, cadastre as mesmas variáveis em Site configuration > Environment variables.

# Endereço público do site (sem barra no final)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mercado Pago (checkout, Fase 6)
MERCADOPAGO_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=

# Supabase (login por link e controle de acesso, Fase 5)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Só no servidor. Nunca exponha no navegador.
SUPABASE_SERVICE_ROLE_KEY=
